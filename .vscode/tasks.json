{
  "version": "2.0.0",
  "tasks": [
    {
      // Auto-runs when the codespace (or any VS Code window) opens this folder.
      // The devcontainer waits for onCreateCommand -> setup.sh to finish before a
      // client may attach, so the toolchain is already in place when this fires.
      "label": "iyf: patch",
      "type": "shell",
      "command": "python3 patch.py",
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
